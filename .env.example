# Copiar a .env.local y completar. Nunca subir .env.local al repositorio.

# URL pública del sitio (canónica, sitemap, imagen para compartir). Sin ella: https://oriont.cl
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile — site key PÚBLICA (la secret key va solo en la Azure Function)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# AzFunc.MailSender — endpoint público del formulario (/api/form-email)
NEXT_PUBLIC_CONTACT_ENDPOINT=

# Opcional: código de verificación de Google Search Console (propiedad "prefijo de URL", método
# etiqueta HTML: solo el valor de content="..."). Con la propiedad "Dominio" se verifica por DNS.
GOOGLE_SITE_VERIFICATION=

# Opcional, solo pruebas: destinatario del aviso interno en vez de contacto@oriont.cl. No definir en producción.
NEXT_PUBLIC_CONTACT_ADMIN_TO=
